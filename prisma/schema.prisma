generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String?       @unique
  password           String
  role               Role          @default(MEMBER)
  phone              String?
  photoUrl           String?
  createdAt          DateTime      @default(now())
  extraSewa1Day      Int?
  extraSewa1Week     Int?
  extraSewa2Day      Int?
  extraSewa2Week     Int?
  firstSewaDay       Int?
  firstSewaWeek      Int?
  secondSewaDay      Int?
  secondSewaWeek     Int?
  thirdSewaDay       Int?
  thirdSewaWeek      Int?
  username           String?       @unique
  mustChangePassword Boolean       @default(false)
  groups             Int[]         @default([])
  approvedAttendance Attendance[]  @relation("ApprovedAttendance")
  attendance         Attendance[]
  broadcasts         Broadcast[]   @relation("CreatedBroadcasts")
  passwordOtps       PasswordOtp[]
}

model PasswordOtp {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
}

model Attendance {
  id             String           @id @default(cuid())
  userId         String
  date           DateTime         @default(now())
  status         AttendanceStatus
  photoUrl       String?
  latitude       Float?
  longitude      Float?
  markedBy       String
  createdAt      DateTime         @default(now())
  approvalStatus ApprovalStatus   @default(APPROVED)
  approvedAt     DateTime?
  approvedBy     String?
  rejectionNote  String?
  areaName       String?
  approvedByUser User?            @relation("ApprovedAttendance", fields: [approvedBy], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([approvalStatus])
  @@index([date])
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  latitude  Float
  longitude Float
  radius    Float    @default(300)
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  mapUrl    String?
}

model Broadcast {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String    @default("INFO")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String
  user      User      @relation("CreatedBroadcasts", fields: [createdBy], references: [id])
}

enum Role {
  ADMIN
  MEMBER
  SUPERADMIN
  INCHARGE
}

enum AttendanceStatus {
  P
  PV
  A
}

enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}
